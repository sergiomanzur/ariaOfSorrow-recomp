rom.cfg

# Self-heal compile cache and per-ROM diagnostic reports (regenerated locally,
# keyed to a specific ROM's game code)
recomp_cache/
recomp_coverage_*.json
recomp_master_misses_*.toml.frag

# recomp-ui runtime assets staged next to the exe at build time
/assets/
